# ==========================================
# Configuration Base de données Aiven Cloud (MySQL)
# Copiez ce fichier vers .env et remplacez les valeurs si nécessaire
# ==========================================
DB_HOST=mysql-ladafura-ladafura-projet.k.aivencloud.com
DB_PORT=20171
# Base `ladafura` : schéma créé par Flyway (V1 à V5). L'ancienne base `defaultdb` n'est plus utilisée.
DB_NAME=ladafura
DB_USERNAME=avnadmin
DB_PASSWORD=VOTRE_MOT_DE_PASSE_AIVEN
# true uniquement pour un premier déploiement : crée la base DB_NAME si elle n'existe pas.
DB_CREATE_IF_MISSING=false
# Migrations Flyway au démarrage (true sur Render ; en local, seulement sur une base dédiée).
FLYWAY_ENABLED=false
# Tâches planifiées SaaS (échéances d'abonnements) : exige V4 et V5 appliquées.
SAAS_TACHES_ENABLED=false

# Anti-veille Render : appel périodique de l'URL publique du service (inutile en local).
MAINTIEN_EVEIL_ENABLED=false
# Sur Render, RENDER_EXTERNAL_URL est utilisée automatiquement ; ne renseigner que pour la forcer.
MAINTIEN_EVEIL_URL=

# Emails de notification (SMTP : Brevo, Gmail avec mot de passe d'application, etc.)
# Sans MAIL_HOST ni MAIL_FROM, aucun email n'est envoyé.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Adresse qui reçoit les demandes de contact ; à défaut, les comptes administrateurs.
LADAFURA_EMAIL_CONTACT=
