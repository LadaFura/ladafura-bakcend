# ==========================================
# Configuration Base de données Aiven Cloud (MySQL)
# Copiez ce fichier vers .env et remplacez les valeurs si nécessaire
# ==========================================
DB_HOST=mysql-ladafura-ladafura-projet.k.aivencloud.com
DB_PORT=20171
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=VOTRE_MOT_DE_PASSE_AIVEN

# Emails de notification (SMTP : Brevo, Gmail avec mot de passe d'application, etc.)
# Sans MAIL_HOST ni MAIL_FROM, aucun email n'est envoyé.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Adresse qui reçoit les demandes de contact ; à défaut, les comptes administrateurs.
LADAFURA_EMAIL_CONTACT=
